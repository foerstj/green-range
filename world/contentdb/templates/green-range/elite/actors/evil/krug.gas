[t:template,n:3W_krug_commander_base]  // = 3W_krug_commander
{
	  category_name = "3W_evil_a";
	  doc = "3W_krug commander";
	  specializes = 3W_base_krug;
	[actor]
	{
		[skills]
		{
			  dexterity = 33.7, 0;
			  intelligence = 15.4, 0;
			  melee = 93,  0;
			  strength = 68.3, 0;
		}
	}
	[aspect]
	{
		  experience_value = 1189427;
		  life = 1692.7;
		  mana = 160.4;
		  material = steel;
		  max_life = 1692.7;
		  max_mana = 160.4;
		  model = m_c_eam_kc_pos_1;
		  scale_base = 1.2;
		  selection_indicator_scale = 0.85;
		[textures]
		{
			  0 = b_c_eam_kc;
		}
	}
	[attack]
	{
		  damage_max = 773.2;
		  damage_min = 521.3;
	}
	[body]
	{
		min_move_velocity = 1.75;
		avg_move_velocity = 2;
	}
	[common]
	{
		  screen_name = "Krug Commander";
		  membership = krug, monster;
	}
	[defend]
	{
		  defense = 908.7;
	}
	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
				  es_weapon_hand = ax_d_d_2h1b_avg;
			}
    		[oneof*]
			{
				[all*]
				{
					[gold*]
					{
						  chance = 0.2;
						  max = 301338;
						  min = 228601;
					}
				}
				[oneof*]
				{
					[all*]
					{
        				chance = 0.01;
    	        	    il_main = #spell/18-36;
					}
					[all*]
					{
        				chance = 0.02;
    	        	    il_main = #spell/45-89;
					}
					[all*]
					{
					    chance = 0.20;
		           	    il_main = #weapon/219-278;
		                il_main = #armor/116-650;
		    			il_main = potion_mana_super;
						il_main = potion_health_super;
                    }
                    [oneof*]
					{
	                   	chance = 0.004;
	                   	il_main = #weapon/-rare(1)/270-371;
	                   	il_main = #armor/-rare(1)/490-882;
                       	il_main = #*/-rare(1)/270-371;
                	}
					[oneof*]
					{
                       	chance = 0.002;
	                   	il_main = #weapon/-unique(2)/270-371;
	                   	il_main = #armor/-unique(2)/490-882;
                       	il_main = #*/-unique(2)/270-371;
                    }
				}
			}
		}
	}
	[mind]
	{
		jat_fidget						= world\ai\jobs\common\job_fidget.skrit
			?social							= 0.35
			&still							= false;

		jat_brain							= world\ai\jobs\common\brain_hero.skrit
			?actor_creates_own_party			= true
			&form_party_on_friend_entered_ICZ	= true
			&form_party_on_friend_entered_OCZ	= true
			&party_template						= "party_krug_commander";
		on_enemy_spotted_alert_friends			= true;
	}
	[physics]
	{
		  break_sound = s_e_meat_explosion;
		  explosion_magnitude = 1.5;
		[break_particulate]
		{
			  frag_glb_krug_commander_01 = 1;
			  frag_glb_krug_commander_02 = 1;
			  frag_glb_krug_commander_03 = 1;
			  frag_glb_krug_commander_04 = 1;
			  frag_glb_krug_commander_05 = 1;
			  frag_glb_krug_commander_06 = 1;
			  frag_glb_krug_commander_07 = 1;
			  frag_glb_krug_commander_08 = 1;
		}
	}
}
[t:template,n:3W_gr_krug_commander] { specializes = 3W_krug_commander_base; }

